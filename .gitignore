# Local OpenTofu/Terraform directories
**/.terraform/*

# Local tooling state (opencode)
.opencode/

# .tfstate files (CRITICAL: Never commit state files to Git!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Generated manifests (kubectl-applied Cilium LoadBalancer CRs)
.gen/

# Exclude all .tfvars files, which are likely to contain sensitive data (Proxmox tokens, IPs)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore OpenTofu/Terraform plan files
*.tfplan
*tfplan*

# -----------------------------------------------------------------------------
# Talos Linux specific files
# -----------------------------------------------------------------------------
# Talos credentials and cluster configuration
talosconfig
*.talosconfig

# Machine configurations (often contain inline certificates and secrets)
*machineconfig*.yaml
*controlplane*.yaml
*worker*.yaml

# Talos generated secrets file
secrets.yaml
*.enc

# -----------------------------------------------------------------------------
# Kubernetes specific files
# -----------------------------------------------------------------------------
# Kubeconfig for cluster access
kubeconfig
kubeconfig.yaml
*.kubeconfig
.kube/

# -----------------------------------------------------------------------------
# OS, Editor & IDE generated files
# -----------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp